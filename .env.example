# Kopiere diese Datei nach .env und passe sie an:  cp .env.example .env

# Auf welcher Adresse der Container lauscht.
# Hinter einem Reverse Proxy auf demselben Host: 127.0.0.1
BIND_ADDRESS=0.0.0.0
PORT=8080

TZ=Europe/Vienna

# Anzahl der Reverse Proxys vor der App (für X-Forwarded-For).
# 0 (Standard) = keinem Proxy-Header vertrauen, sicher für den direkten Betrieb
# ohne Proxy. Nur hochsetzen, wenn wirklich ein Reverse Proxy davorsteht (siehe
# DEPLOY.md) – sonst kann jeder Client per X-Forwarded-For eine beliebige
# Absender-IP behaupten und damit die Login-Bremse umgehen.
TRUST_PROXY=0

# Session-Cookie nur über HTTPS senden. Für einen ersten Test ohne
# Zertifikat vorübergehend auf false setzen.
COOKIE_SECURE=true

SESSION_DAYS=30

# Erster Administrator – wird nur beim allerersten Start angelegt.
# Lässt du ADMIN_PASSWORD leer, erzeugt der Server ein zufälliges Passwort
# und schreibt es einmalig ins Container-Log (docker compose logs).
ADMIN_USER=admin
ADMIN_PASSWORD=

# Cloudflare Tunnel (optional, siehe DEPLOY.md) – HTTPS von außen ohne
# Port-Forwarding am Router. Zum Aktivieren beide Zeilen setzen:
#   COMPOSE_PROFILES=cloudflare
#   CLOUDFLARE_TUNNEL_TOKEN=<Token aus dem Cloudflare Zero Trust Dashboard>
COMPOSE_PROFILES=
CLOUDFLARE_TUNNEL_TOKEN=
